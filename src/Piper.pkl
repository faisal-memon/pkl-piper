/// A Piper Wyoming service rendered as Docker Compose YAML.
module piper.Piper

import "@docker/src/Compose.pkl"

// ── Piper configuration types ───────────────────────────────────────────────

/// Piper application and Compose settings.
class Config {
  /// Compose service name.
  name: String(!isEmpty) = "piper"

  /// Piper voice identifier.
  voice: String(matches(Regex("[A-Za-z0-9._-]+"))) = "en_US-lessac-medium"

  /// Wyoming protocol port served by Piper.
  port: Int(isBetween(1, 65535)) = 10200

  /// Docker image repository.
  image: String(!isEmpty) = "rhasspy/wyoming-piper"

  /// Versioned Piper image tag.
  // renovate: datasource=docker depName=rhasspy/wyoming-piper
  imageTag: String(!isEmpty) = "2.5.2"

  /// Persistent host directory for downloaded voice files.
  hostDataDirectory: String(startsWith("/"), !contains("\n"), !contains("$")) = "/var/lib/piper"

  /// Optional host-side Wyoming endpoint.
  hostPublishing: HostPublishing? = new HostPublishing {}

  /// Optional external Docker networks for internal callers.
  networkNames: Listing<String> = new {}

  /// Container restart policy.
  restartPolicy: String(!isEmpty) = "unless-stopped"
  hidden imageReference = "\(image):\(imageTag)"
}

/// Host-side Wyoming endpoint settings.
class HostPublishing {
  /// Host interface to bind.
  hostIp: String(!isEmpty) = "0.0.0.0"

  /// Host port for the Wyoming endpoint.
  port: Int(isBetween(1, 65535)) = 10200
}

// ── Module configuration ─────────────────────────────────────────────────────

/// Piper configuration supplied by the consumer.
config: Config = new Config {}

networks: Mapping<String, Compose.Network> = new {}

// ── Compose service ──────────────────────────────────────────────────────────

services = new Mapping {
  [config.name] = new Compose.Service {
    image = config.imageReference
    command = new Listing { "--voice"; config.voice }
    restart = config.restartPolicy
    ports = if (config.hostPublishing != null) new Listing {
      new Compose.Port {
        host_ip = config.hostPublishing.hostIp
        published = config.hostPublishing.port
        target = config.port
      }
    } else new {}
    volumes = new Listing {
      new Compose.Volume {
        source = config.hostDataDirectory
        target = "/data"
      }
    }
    networks = config.networkNames
  }
}

// ── YAML output ──────────────────────────────────────────────────────────────

// Piper imports Compose for its typed service model, so Compose's output block
// is not inherited. This output block renders Piper's services and networks;
// the renderer itself remains the shared implementation from pkl-docker.
output {
  value = new Dynamic {
    services = module.services
    networks = module.networks
  }
  renderer = new YamlRenderer {}
}
