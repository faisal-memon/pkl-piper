/// Public Piper deployment façade.
module piper.Deployment

import "@docker/src/Compose.pkl"
import "Piper.pkl"
import "ComposeConfig.pkl"

/// A Piper deployment with application and renderer-specific configuration.
class Service {
  config: Piper.Config = new Piper.Config {}
  compose: ComposeConfig.ComposeConfig = new ComposeConfig.ComposeConfig {}
}
