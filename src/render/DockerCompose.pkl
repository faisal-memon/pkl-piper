/// A Piper deployment built on the shared Docker Compose types.
module piper.DockerCompose

import "@docker/src/Compose.pkl"
import "../Piper.pkl"

/// A Piper deployment with separate application and Compose configuration.
class Server {
  /// Piper application settings independent of the deployment renderer.
  config: Piper.PiperConfig = new Piper.PiperConfig {}

  /// Docker Compose deployment settings.
  compose: ComposeConfig = new ComposeConfig {}

  /// Convert this Piper deployment to the generic Compose service model.
  composeService: Compose.Service = new Compose.Service {
    image = compose.imageReference
    command = new Listing { "--voice"; config.voice }
    restart = compose.restartPolicy
    ports = if (compose.hostPublishing != null) new Listing {
      "\(compose.hostPublishing.hostIp):\(compose.hostPublishing.port):\(config.port)"
    } else new {}
    volumes = new Listing { "\(compose.hostDataDirectory):/data" }
    networks = compose.networkNames
  }
}

/// Docker Compose deployment settings for Piper.
class ComposeConfig {
  /// Compose service name.
  name: String(!isEmpty) = "piper"

  /// Docker image repository.
  image: String(!isEmpty) = "rhasspy/wyoming-piper"

  /// Versioned Piper image tag.
  // renovate: datasource=docker depName=rhasspy/wyoming-piper
  imageTag: String(!isEmpty) = "2.5.2"

  /// Persistent host directory for downloaded voice files.
  hostDataDirectory: String(startsWith("/"), !contains("\n"), !contains("$"))

  /// Optional host-side Wyoming endpoint. Leave null for Docker-network-only access.
  hostPublishing: HostPublishing? = null

  /// Optional external Docker networks for internal callers.
  networkNames: Listing<String> = new {}

  restartPolicy: String(!isEmpty) = "unless-stopped"

  hidden imageReference = "\(image):\(imageTag)"
}

/// Host-side port publishing settings.
class HostPublishing {
  /// Host interface to bind. Use a LAN address when a speaker satellite connects directly.
  hostIp: String(!isEmpty) = "0.0.0.0"

  /// Host port for the Wyoming endpoint.
  port: Int(isBetween(1, 65535)) = 10200
}
