/// A Piper deployment built on the shared Docker Compose types.
module piper.DockerCompose

import "@docker/src/Compose.pkl"
import "../Piper.pkl"
import "../ComposeConfig.pkl"

/// A Piper deployment with separate application and Compose configuration.
class Server {
  /// Piper application settings independent of the deployment renderer.
  config: Piper.PiperConfig = new Piper.PiperConfig {}

  /// Docker Compose deployment settings.
  compose: ComposeConfig.ComposeConfig = new ComposeConfig.ComposeConfig {}

  /// Convert this Piper deployment to the generic Compose service model.
  composeService: Compose.Service = new Compose.Service {
    image = compose.imageReference
    command = new Listing { "--voice"; config.voice }
    restart = compose.restartPolicy
    ports = if (compose.hostPublishing != null) new Listing {
      "\(compose.hostPublishing.hostIp):\(compose.hostPublishing.port):\(config.port)"
    } else new {}
    volumes = new Listing { "\(compose.hostDataDirectory):/data" }
    networks = compose.networkNames
  }
}

