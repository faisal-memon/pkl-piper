{
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)src/.*\\.pkl$"],
      "matchStrings": ["imageTag: String\\([^\\n]+\\) = \\\"(?<currentValue>[^\\\"]+)\\\""] ,
      "datasourceTemplate": "docker",
      "depNameTemplate": "rhasspy/wyoming-piper",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["rhasspy/wyoming-piper"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
