/// Piper Wyoming service suitable for a local voice-assistant endpoint.
amends "../src/Piper.pkl"


config {
  piper {
    voice = "en_US-lessac-medium"
    port = 10200
  }
  docker {
    hostDataDirectory = "./data/piper"
    networks = new Mapping {
      ["ai_net"] = new NetworkConfig { `external` = true }
    }
  }
}
