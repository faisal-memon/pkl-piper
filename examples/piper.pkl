/// Piper Wyoming service suitable for a local voice-assistant endpoint.
amends "@docker/src/ComposeRender.pkl"

import "@docker/src/Compose.pkl"
import "../src/render/DockerCompose.pkl"
import "../src/Deployment.pkl"
import "../src/ComposeConfig.pkl"
import "../src/PiperConfig.pkl"

local piper = new DockerCompose.Server {
  deployment = new Deployment.Piper {
    config = new PiperConfig.PiperConfig {
    voice = "en_US-lessac-medium"
    port = 10200
  }
    compose = new ComposeConfig.ComposeConfig {
    hostDataDirectory = "/var/lib/piper"
    hostPublishing = new ComposeConfig.HostPublishing {}
    networkNames = new Listing { "ai_net" }
    }
  }
}

config {
  services = new Mapping {
    [piper.compose.name] = piper.composeService
  }
  networks = new Mapping {
    ["ai_net"] = new Compose.Network { `external` = true }
  }
}
